{
  "name": "xote-monorepo",
  "private": true,
  "description": "Xote and xote-native, in one repository",
  "repository": {
    "url": "https://github.com/brnrdog/xote"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Bernardo Gurgel <brnrdog@hey.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "res:build": "npm -w xote run res:build",
    "res:clean": "npm -w xote run res:clean",
    "res:dev": "npm -w xote run res:dev",
    "format": "npm -w xote run format",
    "dev": "npm -w xote run dev",
    "build": "npm -w xote run build",
    "bundle:size": "npm -w xote run bundle:size",
    "preview": "npm -w xote run preview",
    "mdx:poc": "npm -w xote run mdx:poc",
    "test": "npm -w xote test",
    "test:exports": "npm -w xote run test:exports",
    "test:boundary": "npm -w xote run test:boundary",
    "ppx:build": "npm -w xote run ppx:build",
    "ppx:test": "npm -w xote run ppx:test",
    "native:test": "npm -w xote-native test",
    "native:conformance": "npm -w xote-native run conformance",
    "native:package": "npm -w xote-native run test:package",
    "native:layout:oracle": "npm -w xote-native run layout:oracle",
    "native:bundle": "npm -w xote-native run bundle",
    "native:bundle:test": "npm -w xote-native run bundle:test",
    "native:preview": "npm -w xote-native run preview",
    "native:measure": "npm -w xote-native run measure",
    "native:build": "npm -w xote-native run preview:build",
    "docs:start": "npm --prefix docs-website run dev",
    "docs:build": "npm --prefix docs-website run build",
    "docs:serve": "npm --prefix docs-website run preview"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "rc",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "docs/CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "docs/CHANGELOG.md"
          ]
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/npm",
        {
          "pkgRoot": "packages/xote"
        }
      ]
    ]
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "glob": "^11.1.0",
    "jsdom": "^28.1.0",
    "remark-gfm": "^4.0.1",
    "rescript": "^12.0.0",
    "semantic-release": "^25.0.1",
    "vite": "^8.0.16",
    "zekr": "^1.7.0"
  }
}
