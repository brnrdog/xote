.DS_Store
/node_modules/
/lib/
/dist/
/examples/*/dist/

# The xote-native package: its own build output, and the `node_modules/xote`
# symlink `scripts/link-workspace.mjs` makes so it can resolve the package next
# door.
/xote-native/node_modules/
/xote-native/lib/
/xote-native/bundle/dist/
/xote-native/example/dist/
/benchmarks/node_modules/
/benchmarks/dist/
.bsb.lock
.merlin
*.res.mjs
bundlemeta.json
bundle-size-report.md
bundle-size-*.json
.vite

# Documentation site
/docs-website/node_modules/
/docs-website/build/
/docs-website/.cache-loader/
/docs-website/static/assets/
/benchmarks/ci-results/
/benchmark-report.md

# Compiled ppx binaries (kept out of ppx/.gitignore on purpose: npm honors
# nested ignore files when packing, and ppx/bin must ship in the tarball)
/ppx/ppx
/ppx/ppx.exe
/ppx/bin/

# Consumer boundary fixture (generated)
/tests/consumer/node_modules/
/tests/consumer/lib/
/tests/consumer/probe/

# Android host build output — the SDK and Gradle are not available here.
/xote-native/hosts/android/.gradle/
/xote-native/hosts/android/build/
/xote-native/hosts/android/app/build/
/xote-native/hosts/android/local.properties
