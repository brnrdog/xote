{
  "name": "xote-native",
  "namespace": true,
  "sources": [
    {
      "dir": "src",
      "subdirs": false
    },
    {
      "dir": "example",
      "subdirs": true,
      "type": "dev"
    }
  ],
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "dependencies": [
    "rescript-signals",
    "xote"
  ],
  "compiler-flags": [
    "-open Xote"
  ],
  "jsx": {
    "version": 4,
    "module": "NativeJSX"
  }
}
