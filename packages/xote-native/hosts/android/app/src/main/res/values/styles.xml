<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar and no window background of its own: every pixel on
         screen is one the layout engine placed, the same as on iOS. -->
    <style name="XoteTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
